<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <RollingFile name="detail" append="true" fileName="logs/detail.log" filePattern="logs/detail.log.%d{yyyy-MM}">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %p [%c] - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/><!-- 1 month roll over -->
            </Policies>
        </RollingFile>
        <RollingFile name="status" append="true" fileName="logs/status.log" filePattern="logs/status.log.%d{yyyy-MM}">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %p [%c] - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
        </RollingFile>
        <!-- Generate (--mode generate) summary. createOnDemand keeps an embed run from
             truncating it, so run.log always holds the last generation summary. Emailed. -->
        <File name="summary" append="false" createOnDemand="true" fileName="run.log">
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </File>

        <RollingFile name="dupeDetail" append="true" fileName="logs/dupeDetail.log" filePattern="logs/dupeDetail.log.%d{yyyy-MM}">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %p [%c] - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/><!-- 1 month roll over -->
            </Policies>
        </RollingFile>
        <RollingFile name="dupeStatus" append="true" fileName="logs/dupeStatus.log" filePattern="logs/dupeStatus.log.%d{yyyy-MM}">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %p [%c] - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
        </RollingFile>
        <File name="dupeSummary" append="false" fileName="logs/dupeSummary.log">
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </File>

        <RollingFile name="notfoundDetail" append="true" fileName="logs/notfoundDetail.log" filePattern="logs/notfoundDetail.log.%d{yyyy-MM}">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %p [%c] - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/><!-- 1 month roll over -->
            </Policies>
        </RollingFile>
        <RollingFile name="notfoundStatus" append="true" fileName="logs/notfoundStatus.log" filePattern="logs/notfoundStatus.log.%d{yyyy-MM}">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %p [%c] - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
        </RollingFile>

        <File name="notfoundSummary" append="false" fileName="logs/notfoundSummary.log">
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </File>
        <RollingFile name="noSampleDetail" append="true" fileName="logs/noSampleDetail.log" filePattern="logs/noSampleDetail.log.%d{yyyy-MM}">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %p [%c] - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/><!-- 1 month roll over -->
            </Policies>
        </RollingFile>
        <RollingFile name="noSampleStatus" append="true" fileName="logs/noSampleStatus.log" filePattern="logs/noSampleStatus.log.%d{yyyy-MM}">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %p [%c] - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
        </RollingFile>
        <File name="noSampleSummary" append="false" fileName="logs/noSampleSummary.log">
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </File>

        <!-- Embed (--mode embed) gets its own logs, separate from the generate run.
             embedRun.log is rewritten each run (append=false), INFO-only, and kept small
             so it can be emailed. Verbose per-file diagnostics go to embedDetail.log only. -->
        <File name="embedRun" append="false" createOnDemand="true" fileName="logs/embedRun.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %p - %m%n"/>
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </File>
        <RollingFile name="embedDetail" append="true" fileName="logs/embedDetail.log" filePattern="logs/embedDetail.log.%d{yyyy-MM}">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %p [%c] - %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/><!-- 1 month roll over -->
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
        <Logger name="status" level="debug" additivity="false">
            <AppenderRef ref="detail"/>
            <AppenderRef ref="status" level="info"/>
            <AppenderRef ref="summary" level="info"/>
            <AppenderRef ref="Console" level="info"/>
        </Logger>
        <Logger name="notfoundStatus" level="debug" additivity="false">
            <AppenderRef ref="notfoundDetail"/>
            <AppenderRef ref="notfoundStatus" level="info"/>
            <AppenderRef ref="notfoundSummary" level="info"/>
            <AppenderRef ref="Console" level="info"/>
        </Logger>
        <Logger name="noSampleStatus" level="debug" additivity="false">
            <AppenderRef ref="noSampleDetail"/>
            <AppenderRef ref="noSampleStatus" level="info"/>
            <AppenderRef ref="noSampleSummary" level="info"/>
        </Logger>
        <Logger name="dupeStatus" level="debug" additivity="false">
            <AppenderRef ref="dupeDetail"/>
            <AppenderRef ref="dupeStatus" level="info"/>
            <AppenderRef ref="dupeSummary" level="info"/>
            <AppenderRef ref="Console" level="info"/>
        </Logger>
        <Logger name="embed" level="debug" additivity="false">
            <AppenderRef ref="embedDetail"/>
            <AppenderRef ref="embedRun" level="info"/>
            <AppenderRef ref="Console" level="info"/>
        </Logger>
    </Loggers>
</Configuration>