<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN" "http://www.springframework.org/dtd/spring-beans.dtd">
<beans>
    <bean id="dao" class="edu.mcw.rgd.chatBotEmbed.DAO"/>

    <bean id="geneReportGenerator" class="edu.mcw.rgd.chatBotEmbed.generators.GeneReportGenerator">
        <constructor-arg ref="dao"/>
    </bean>

    <bean id="qtlReportGenerator" class="edu.mcw.rgd.chatBotEmbed.generators.QtlReportGenerator">
        <constructor-arg ref="dao"/>
    </bean>

    <bean id="strainReportGenerator" class="edu.mcw.rgd.chatBotEmbed.generators.StrainReportGenerator">
        <constructor-arg ref="dao"/>
    </bean>

    <!-- Accession-keyed (ontology-term) generator; run with type "ontology" (see Manager usage). -->
    <bean id="ontologyReportGenerator" class="edu.mcw.rgd.chatBotEmbed.generators.OntologyReportGenerator">
        <constructor-arg ref="dao"/>
    </bean>

    <!--
      "-mode embed": chunk the generated markdown and write vectors to the Postgres
      document_embeddings table (rgdcore's "rgdRag" datasource, configured in the same
      connections file as the Oracle datasource).

      CRITICAL: model + dimensions MUST match the chatbot's embedding model
      (its spring.ai.*.embedding settings). Vectors from a different model are not
      comparable to the chatbot's query vectors, so a mismatch silently ruins retrieval.
      The API key is read from the named environment variable, never committed.
    -->
    <bean id="embedService" class="edu.mcw.rgd.chatBotEmbed.embed.EmbedService">
        <property name="provider" value="openai"/>                       <!-- openai | ollama -->
        <property name="baseUrl" value="https://api.openai.com/v1"/>
        <property name="model" value="text-embedding-3-large"/>          <!-- MUST match the chatbot (spring.ai.openai.embedding.options.model) -->
        <property name="dimensions" value="1536"/>                       <!-- MUST match the chatbot (spring.ai.openai.embedding.options.dimensions) -->

        <!-- API key: read from a file containing ONLY the key (kept out of git, like the
             connections file). If apiKeyFile is blank, falls back to the apiKeyEnv env var. -->
        <property name="apiKeyFile" value="properties/openai.key"/>
        <property name="apiKeyEnv" value="OPENAI_API_KEY"/>

        <property name="threadCount" value="2"/>
        <property name="dataSourceName" value="rgdRag"/>                 <!-- rgdRagDataSource bean in the connections file -->
        <property name="expectedSchema" value="public"/>                 <!-- schema that datasource must resolve document_embeddings to -->
    </bean>

    <!--
      qwen3-embedding:8b on grudge's Ollama, written to the "qwen" schema of rgd_rag.
      Selected by the run.sh index option (index qwen). Writes through the rgdRagQwenDataSource
      bean in the same connections file, whose URL ends in ?currentSchema=qwen,public.
      expectedSchema makes a run abort before any write if the two ever disagree.

      Documents are embedded WITHOUT an instruction prefix; Qwen3-Embedding wants one only on
      queries, which the chatbot adds on its side. dimensions MUST match the chatbot's.
    -->
    <bean id="embedServiceQwen" class="edu.mcw.rgd.chatBotEmbed.embed.EmbedService">
        <property name="provider" value="ollama"/>
        <property name="baseUrl" value="http://grudge.rgd.mcw.edu:11434"/>
        <property name="model" value="qwen3-embedding:8b"/>
        <property name="dimensions" value="1536"/>                       <!-- qwen.document_embeddings.embedding is vector(1536) -->
        <property name="batchSize" value="32"/>
        <!-- grudge also serves the chat LLMs; keep concurrent embedding requests low. -->
        <property name="threadCount" value="2"/>
        <property name="dataSourceName" value="rgdRagQwen"/>
        <property name="expectedSchema" value="qwen"/>
    </bean>

    <bean id="manager" class="edu.mcw.rgd.chatBotEmbed.Manager">
        <property name="version" value="RGD AI chatbot RAG markdown generator -- build Oct 02, 2026"/>

        <!-- Must match the chatbot's report.loader.output-dir so BulkEmbedService sees the files. -->
        <property name="outputDir" value="data/markdown"/>

        <property name="threadCount" value="5"/>

        <!-- Default assemblies for Position sections; override per-run with -mapKeys.
             Fill in the real rat map keys (e.g. GRCr8, mRatBN7.2). Empty = show ALL of each
             gene's mapped positions on genome assemblies of its own species. -->
        <property name="defaultAssemblyMapKeys" value=""/>

        <property name="generators">
            <list>
                <ref bean="geneReportGenerator"/>
                <ref bean="qtlReportGenerator"/>
                <ref bean="strainReportGenerator"/>
            </list>
        </property>

        <!-- Accession-keyed generators (ontology terms), run on Manager's term path. -->
        <property name="termGenerators">
            <list>
                <ref bean="ontologyReportGenerator"/>
            </list>
        </property>

        <property name="embedService" ref="embedService"/>

        <!-- Named embed configs for the run.sh index option. -->
        <property name="embedServices">
            <map>
                <entry key="qwen" value-ref="embedServiceQwen"/>
            </map>
        </property>
    </bean>

</beans>
